@model IEnumerable<Clinics_Websites_Shops.Models.ClinicLocation>

@{
    ViewData["Title"] = "Clinic Locations";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box">
                <div class="page-title-right">
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i> Add New Location
                    </a>
                </div>
                <h4 class="page-title">
                    <i class="fas fa-map-marker-alt me-2"></i>Clinic Locations
                </h4>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    @if (TempData["success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-map-marker-alt fa-4x text-muted mb-3"></i>
                            <h5 class="text-muted">No locations found</h5>
                            <p class="text-muted">Add your first clinic location to get started</p>
                            <a asp-action="Create" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i> Add Location
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped" id="locationsTable">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Location Name</th>
                                        <th>Code</th>
                                        <th>Address</th>
                                        <th>City</th>
                                        <th>Phone</th>
                                        <th>Email</th>
                                        <th>Status</th>
                                        <th>Default</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var location in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@location.LocationName</strong>
                                                @if (location.IsDefault)
                                                {
                                                    <span class="badge bg-primary ms-2">Default</span>
                                                }
                                            </td>
                                            <td>@(location.LocationCode ?? "N/A")</td>
                                            <td>
                                                <small>@location.Address</small>
                                                @if (!string.IsNullOrEmpty(location.Area))
                                                {
                                                    <br /><small class="text-muted">@location.Area</small>
                                                }
                                            </td>
                                            <td>@location.City, @location.Country</td>
                                            <td>@location.PrimaryPhone</td>
                                            <td>@location.Email</td>
                                            <td>
                                                @if (location.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactive</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!location.IsDefault)
                                                {
                                                    <button class="btn btn-sm btn-outline-primary set-default-btn" data-id="@location.Id">
                                                        <i class="fas fa-star"></i> Set Default
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="text-success"><i class="fas fa-check-circle"></i> Default</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-action="Details" asp-route-id="@location.Id" class="btn btn-sm btn-info" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a asp-action="Edit" asp-route-id="@location.Id" class="btn btn-sm btn-warning" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    @if (!location.IsDefault)
                                                    {
                                                        <button class="btn btn-sm btn-danger delete-btn" data-id="@location.Id" title="Delete">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable
            $('#locationsTable').DataTable({
                order: [[0, 'asc']],
                pageLength: 10
            });

            // Set Default Location
            $('.set-default-btn').click(function() {
                const locationId = $(this).data('id');
                if (confirm('Are you sure you want to set this as the default location?')) {
                    $.ajax({
                        url: '@Url.Action("SetDefault", "Location")',
                        type: 'POST',
                        data: { id: locationId },
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                location.reload();
                            } else {
                                alert(response.message);
                            }
                        },
                        error: function() {
                            alert('An error occurred while setting the default location');
                        }
                    });
                }
            });

            // Delete Location
            $('.delete-btn').click(function() {
                const locationId = $(this).data('id');
                if (confirm('Are you sure you want to delete this location? This action cannot be undone.')) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Location")',
                        type: 'POST',
                        data: { id: locationId },
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                location.reload();
                            } else {
                                alert(response.message);
                            }
                        },
                        error: function() {
                            alert('An error occurred while deleting the location');
                        }
                    });
                }
            });
        });
    </script>
}

