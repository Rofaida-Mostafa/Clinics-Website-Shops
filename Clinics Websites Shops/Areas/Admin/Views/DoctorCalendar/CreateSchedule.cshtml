@model DoctorSchedule

@{
    ViewData["Title"] = "Add Weekly Schedule";
    var doctorName = ViewBag.DoctorName as string;
    var locations = ViewBag.Locations as List<SelectListItem>;
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2><i class="fas fa-calendar-plus me-2"></i>Add Weekly Schedule</h2>
            <p class="text-muted">Create a new weekly schedule for <strong>@doctorName</strong></p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-clock me-2"></i>Schedule Details</h5>
                </div>
                <div class="card-body">
                    <form asp-action="CreateSchedule" method="post">
                        <input type="hidden" asp-for="DoctorId" />
                        <input type="hidden" asp-for="TenantId" />

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="DayOfWeek" class="form-label">Day of Week *</label>
                                <select asp-for="DayOfWeek" class="form-select" required>
                                    <option value="">-- Select Day --</option>
                                    <option value="0">Sunday</option>
                                    <option value="1">Monday</option>
                                    <option value="2">Tuesday</option>
                                    <option value="3">Wednesday</option>
                                    <option value="4">Thursday</option>
                                    <option value="5">Friday</option>
                                    <option value="6">Saturday</option>
                                </select>
                                <span asp-validation-for="DayOfWeek" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Status</label>
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                                    <label asp-for="IsActive" class="form-check-label">Active</label>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="StartTime" class="form-label">Start Time *</label>
                                <input asp-for="StartTime" type="time" class="form-control" required />
                                <span asp-validation-for="StartTime" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EndTime" class="form-label">End Time *</label>
                                <input asp-for="EndTime" type="time" class="form-control" required />
                                <span asp-validation-for="EndTime" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="BreakStartTime" class="form-label">Break Start Time</label>
                                <input asp-for="BreakStartTime" type="time" class="form-control" />
                                <small class="text-muted">Optional lunch/break time</small>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="BreakEndTime" class="form-label">Break End Time</label>
                                <input asp-for="BreakEndTime" type="time" class="form-control" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="SlotDurationMinutes" class="form-label">Slot Duration (minutes) *</label>
                                <input asp-for="SlotDurationMinutes" type="number" class="form-control" min="5" max="120" required />
                                <small class="text-muted">Default: 30 minutes</small>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="BufferTimeMinutes" class="form-label">Buffer Time (minutes)</label>
                                <input asp-for="BufferTimeMinutes" type="number" class="form-control" min="0" max="60" />
                                <small class="text-muted">Time between appointments</small>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MaxAppointmentsPerSlot" class="form-label">Max Appointments/Slot</label>
                                <input asp-for="MaxAppointmentsPerSlot" type="number" class="form-control" min="1" max="10" />
                                <small class="text-muted">Usually 1</small>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="LocationId" class="form-label">Location</label>
                                <select asp-for="LocationId" class="form-select">
                                    <option value="">-- Select Location --</option>
                                    @if (locations != null)
                                    {
                                        foreach (var location in locations)
                                        {
                                            <option value="@location.Value">@location.Text</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="RoomNumber" class="form-label">Room Number</label>
                                <input asp-for="RoomNumber" class="form-control" placeholder="e.g., Room 101" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="EffectiveFrom" class="form-label">Effective From</label>
                                <input asp-for="EffectiveFrom" type="date" class="form-control" />
                                <small class="text-muted">Leave empty for permanent schedule</small>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EffectiveTo" class="form-label">Effective To</label>
                                <input asp-for="EffectiveTo" type="date" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Any special notes about this schedule..."></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index", new { doctorId = Model.DoctorId })" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Back to Calendar
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-1"></i>Save Schedule
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Schedule Tips</h6>
                </div>
                <div class="card-body">
                    <ul class="small">
                        <li>Create a schedule for each day the doctor works</li>
                        <li>Slot duration determines appointment length</li>
                        <li>Buffer time adds gaps between appointments</li>
                        <li>Break time blocks out lunch/rest periods</li>
                        <li>Use effective dates for temporary schedule changes</li>
                        <li>Inactive schedules won't show in appointment booking</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

