@{
    ViewData["Title"] = "Doctor Calendar Management";
    var doctors = ViewBag.Doctors as List<SelectListItem>;
    var selectedDoctorId = ViewBag.SelectedDoctorId as int?;
    var doctorName = ViewBag.DoctorName as string;
    var schedules = ViewBag.Schedules as List<DoctorSchedule>;
    var holidays = ViewBag.Holidays as List<DoctorHoliday>;
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2><i class="fas fa-calendar-alt me-2"></i>Doctor Calendar Management</h2>
            <p class="text-muted">Manage doctor schedules, working hours, and holidays</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Doctor Selection -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-user-md me-2"></i>Select Doctor</h5>
        </div>
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row">
                    <div class="col-md-8">
                        <select name="doctorId" class="form-select" id="doctorSelect" required>
                            <option value="">-- Select a Doctor --</option>
                            @if (doctors != null)
                            {
                                foreach (var doctor in doctors)
                                {
                                    <option value="@doctor.Value" selected="@(doctor.Value == selectedDoctorId?.ToString())">@doctor.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search me-1"></i>View Calendar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (selectedDoctorId.HasValue)
    {
        <!-- Doctor Info -->
        <div class="alert alert-info">
            <h5><i class="fas fa-info-circle me-2"></i>Managing Calendar for: <strong>@doctorName</strong></h5>
        </div>

        <!-- Weekly Schedule Section -->
        <div class="card mb-4">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-clock me-2"></i>Weekly Schedule</h5>
                <a href="@Url.Action("CreateSchedule", new { doctorId = selectedDoctorId })" class="btn btn-light btn-sm">
                    <i class="fas fa-plus me-1"></i>Add Schedule
                </a>
            </div>
            <div class="card-body">
                @if (schedules != null && schedules.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Day</th>
                                    <th>Working Hours</th>
                                    <th>Break Time</th>
                                    <th>Slot Duration</th>
                                    <th>Location</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var schedule in schedules)
                                {
                                    <tr>
                                        <td><strong>@schedule.DayName</strong></td>
                                        <td>@schedule.StartTime.ToString(@"hh\:mm") - @schedule.EndTime.ToString(@"hh\:mm")</td>
                                        <td>
                                            @if (schedule.BreakStartTime.HasValue && schedule.BreakEndTime.HasValue)
                                            {
                                                @schedule.BreakStartTime.Value.ToString(@"hh\:mm") <text>-</text> @schedule.BreakEndTime.Value.ToString(@"hh\:mm")
                                            }
                                            else
                                            {
                                                <span class="text-muted">No break</span>
                                            }
                                        </td>
                                        <td>@schedule.SlotDurationMinutes min</td>
                                        <td>@(schedule.Location?.LocationName ?? "Not specified")</td>
                                        <td>
                                            @if (schedule.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <a href="@Url.Action("EditSchedule", new { id = schedule.Id })" class="btn btn-sm btn-warning">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-danger" onclick="deleteSchedule(@schedule.Id)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>No weekly schedule configured. Click "Add Schedule" to create one.
                    </div>
                }
            </div>
        </div>

        <!-- Holidays & Time Off Section -->
        <div class="card mb-4">
            <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-umbrella-beach me-2"></i>Holidays & Time Off</h5>
                <a href="@Url.Action("CreateHoliday", new { doctorId = selectedDoctorId })" class="btn btn-dark btn-sm">
                    <i class="fas fa-plus me-1"></i>Add Holiday
                </a>
            </div>
            <div class="card-body">
                @if (holidays != null && holidays.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Type</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Duration</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var holiday in holidays)
                                {
                                    var isPast = holiday.EndDate < DateTime.Now;
                                    var isCurrent = holiday.StartDate <= DateTime.Now && holiday.EndDate >= DateTime.Now;
                                    var isFuture = holiday.StartDate > DateTime.Now;

                                    <tr class="@(isPast ? "table-secondary" : isCurrent ? "table-info" : "")">
                                        <td>
                                            <strong>@holiday.Title</strong>
                                            @if (!string.IsNullOrEmpty(holiday.Description))
                                            {
                                                <br /><small class="text-muted">@holiday.Description</small>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-info">@holiday.HolidayType</span>
                                        </td>
                                        <td>@holiday.StartDate.ToString("MMM dd, yyyy")</td>
                                        <td>@holiday.EndDate.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            @if (holiday.IsFullDay)
                                            {
                                                var days = (holiday.EndDate.Date - holiday.StartDate.Date).Days + 1;
                                                <span>@days day(s)</span>
                                            }
                                            else
                                            {
                                                <span>Partial</span>
                                            }
                                        </td>
                                        <td>
                                            @if (holiday.IsApproved)
                                            {
                                                if (isCurrent)
                                                {
                                                    <span class="badge bg-primary">Active Now</span>
                                                }
                                                else if (isFuture)
                                                {
                                                    <span class="badge bg-success">Approved</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Completed</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">@holiday.Status</span>
                                            }
                                        </td>
                                        <td>
                                            <a href="@Url.Action("EditHoliday", new { id = holiday.Id })" class="btn btn-sm btn-warning">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-danger" onclick="deleteHoliday(@holiday.Id)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>No holidays or time off scheduled. Click "Add Holiday" to create one.
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function deleteSchedule(id) {
            if (confirm('Are you sure you want to delete this schedule?')) {
                $.ajax({
                    url: '@Url.Action("DeleteSchedule")',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (result) {
                        if (result.success) {
                            location.reload();
                        } else {
                            alert(result.message);
                        }
                    },
                    error: function () {
                        alert('An error occurred while deleting the schedule.');
                    }
                });
            }
        }

        function deleteHoliday(id) {
            if (confirm('Are you sure you want to delete this holiday?')) {
                $.ajax({
                    url: '@Url.Action("DeleteHoliday")',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (result) {
                        if (result.success) {
                            location.reload();
                        } else {
                            alert(result.message);
                        }
                    },
                    error: function () {
                        alert('An error occurred while deleting the holiday.');
                    }
                });
            }
        }
    </script>
}


