@model Clinics_Websites_Shops.Models.ClinicSettings

@{
    ViewData["Title"] = "Clinic Settings";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2><i class="bi bi-gear"></i> Clinic Settings</h2>
        </div>
    </div>

    <form asp-action="Update" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="TenantId" />
        <input type="hidden" asp-for="CreatedAt" />

        <!-- Tabs -->
        <ul class="nav nav-tabs" id="settingsTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="clinic-tab" data-bs-toggle="tab" data-bs-target="#clinic" type="button" role="tab">
                    <i class="bi bi-building"></i> Clinic Info
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="appointments-tab" data-bs-toggle="tab" data-bs-target="#appointments" type="button" role="tab">
                    <i class="bi bi-calendar-check"></i> Appointments
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="financial-tab" data-bs-toggle="tab" data-bs-target="#financial" type="button" role="tab">
                    <i class="bi bi-currency-dollar"></i> Financial
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="notifications-tab" data-bs-toggle="tab" data-bs-target="#notifications" type="button" role="tab">
                    <i class="bi bi-bell"></i> Notifications
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="security-tab" data-bs-toggle="tab" data-bs-target="#security" type="button" role="tab">
                    <i class="bi bi-shield-lock"></i> Security
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="features-tab" data-bs-toggle="tab" data-bs-target="#features" type="button" role="tab">
                    <i class="bi bi-toggles"></i> Features
                </button>
            </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content mt-3" id="settingsTabsContent">
            <!-- Clinic Info Tab -->
            <div class="tab-pane fade show active" id="clinic" role="tabpanel">
                <div class="card">
                    <div class="card-header">
                        <h5><i class="bi bi-building"></i> Clinic Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ClinicName" class="form-label">Clinic Name *</label>
                                    <input asp-for="ClinicName" class="form-control" required />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="ClinicDescription" class="form-label">Description</label>
                                    <textarea asp-for="ClinicDescription" class="form-control" rows="3"></textarea>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Phone" class="form-label">Phone</label>
                                    <input asp-for="Phone" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Fax" class="form-label">Fax</label>
                                    <input asp-for="Fax" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label">Email</label>
                                    <input asp-for="Email" type="email" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Website" class="form-label">Website</label>
                                    <input asp-for="Website" type="url" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Address" class="form-label">Address</label>
                                    <input asp-for="Address" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="City" class="form-label">City</label>
                                    <input asp-for="City" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="State" class="form-label">State/Province</label>
                                    <input asp-for="State" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="PostalCode" class="form-label">Postal Code</label>
                                    <input asp-for="PostalCode" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Country" class="form-label">Country</label>
                                    <input asp-for="Country" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="TimeZone" class="form-label">Time Zone</label>
                                    <input asp-for="TimeZone" class="form-control" placeholder="e.g., America/New_York" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="BusinessHours" class="form-label">Business Hours</label>
                                    <textarea asp-for="BusinessHours" class="form-control" rows="3" placeholder="e.g., Mon-Fri: 9AM-5PM"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Appointments Tab -->
            <div class="tab-pane fade" id="appointments" role="tabpanel">
                <div class="card">
                    <div class="card-header">
                        <h5><i class="bi bi-calendar-check"></i> Appointment Settings</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="DefaultAppointmentDuration" class="form-label">Default Appointment Duration (minutes)</label>
                                    <input asp-for="DefaultAppointmentDuration" type="number" class="form-control" min="5" max="480" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="AppointmentSlotInterval" class="form-label">Appointment Slot Interval (minutes)</label>
                                    <input asp-for="AppointmentSlotInterval" type="number" class="form-control" min="5" max="60" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="ReminderHoursBefore" class="form-label">Send Reminder (hours before)</label>
                                    <input asp-for="ReminderHoursBefore" type="number" class="form-control" min="1" max="168" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3 form-check">
                                    <input asp-for="AllowOnlineBooking" class="form-check-input" type="checkbox" />
                                    <label asp-for="AllowOnlineBooking" class="form-check-label">Allow Online Booking</label>
                                </div>
                                <div class="mb-3 form-check">
                                    <input asp-for="RequireAppointmentConfirmation" class="form-check-input" type="checkbox" />
                                    <label asp-for="RequireAppointmentConfirmation" class="form-check-label">Require Appointment Confirmation</label>
                                </div>
                                <div class="mb-3 form-check">
                                    <input asp-for="SendEmailReminders" class="form-check-input" type="checkbox" />
                                    <label asp-for="SendEmailReminders" class="form-check-label">Send Email Reminders</label>
                                </div>
                                <div class="mb-3 form-check">
                                    <input asp-for="SendSmsReminders" class="form-check-input" type="checkbox" />
                                    <label asp-for="SendSmsReminders" class="form-check-label">Send SMS Reminders</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Financial Tab -->
            <div class="tab-pane fade" id="financial" role="tabpanel">
                <div class="card">
                    <div class="card-header">
                        <h5><i class="bi bi-currency-dollar"></i> Financial Settings</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Currency" class="form-label">Currency Code</label>
                                    <input asp-for="Currency" class="form-control" placeholder="e.g., USD, EUR, GBP" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="CurrencySymbol" class="form-label">Currency Symbol</label>
                                    <input asp-for="CurrencySymbol" class="form-control" placeholder="e.g., $, €, £" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="DefaultConsultationFee" class="form-label">Default Consultation Fee</label>
                                    <input asp-for="DefaultConsultationFee" type="number" step="0.01" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="TaxRate" class="form-label">Tax Rate (%)</label>
                                    <input asp-for="TaxRate" type="number" step="0.01" class="form-control" min="0" max="100" />
                                </div>
                                <div class="mb-3 form-check">
                                    <input asp-for="RequirePaymentAtBooking" class="form-check-input" type="checkbox" />
                                    <label asp-for="RequirePaymentAtBooking" class="form-check-label">Require Payment at Booking</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Notifications Tab -->
            <div class="tab-pane fade" id="notifications" role="tabpanel">
                <div class="card">
                    <div class="card-header">
                        <h5><i class="bi bi-bell"></i> Notification Settings</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="border-bottom pb-2 mb-3">General</h6>
                                <div class="mb-3 form-check">
                                    <input asp-for="EnableEmailNotifications" class="form-check-input" type="checkbox" />
                                    <label asp-for="EnableEmailNotifications" class="form-check-label">Enable Email Notifications</label>
                                </div>
                                <div class="mb-3 form-check">
                                    <input asp-for="EnableSmsNotifications" class="form-check-input" type="checkbox" />
                                    <label asp-for="EnableSmsNotifications" class="form-check-label">Enable SMS Notifications</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h6 class="border-bottom pb-2 mb-3">Localization</h6>
                                <div class="mb-3">
                                    <label asp-for="DefaultLanguage" class="form-label">Default Language</label>
                                    <input asp-for="DefaultLanguage" class="form-control" placeholder="e.g., en, ar" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="DefaultCulture" class="form-label">Default Culture</label>
                                    <input asp-for="DefaultCulture" class="form-control" placeholder="e.g., en-US, ar-SA" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="SupportedLanguages" class="form-label">Supported Languages</label>
                                    <input asp-for="SupportedLanguages" class="form-control" placeholder="e.g., en,ar,fr" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Security Tab -->
            <div class="tab-pane fade" id="security" role="tabpanel">
                <div class="card">
                    <div class="card-header">
                        <h5><i class="bi bi-shield-lock"></i> Security Settings</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="SessionTimeoutMinutes" class="form-label">Session Timeout (minutes)</label>
                                    <input asp-for="SessionTimeoutMinutes" type="number" class="form-control" min="5" max="1440" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="PasswordExpiryDays" class="form-label">Password Expiry (days)</label>
                                    <input asp-for="PasswordExpiryDays" type="number" class="form-control" min="0" max="365" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="MaxLoginAttempts" class="form-label">Max Login Attempts</label>
                                    <input asp-for="MaxLoginAttempts" type="number" class="form-control" min="1" max="10" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3 form-check">
                                    <input asp-for="RequireTwoFactorAuth" class="form-check-input" type="checkbox" />
                                    <label asp-for="RequireTwoFactorAuth" class="form-check-label">Require Two-Factor Authentication</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Features Tab -->
            <div class="tab-pane fade" id="features" role="tabpanel">
                <div class="card">
                    <div class="card-header">
                        <h5><i class="bi bi-toggles"></i> Feature Flags</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3 form-check">
                                    <input asp-for="EnablePatientPortal" class="form-check-input" type="checkbox" />
                                    <label asp-for="EnablePatientPortal" class="form-check-label">Enable Patient Portal</label>
                                </div>
                                <div class="mb-3 form-check">
                                    <input asp-for="EnableOnlinePayments" class="form-check-input" type="checkbox" />
                                    <label asp-for="EnableOnlinePayments" class="form-check-label">Enable Online Payments</label>
                                </div>
                                <div class="mb-3 form-check">
                                    <input asp-for="EnableTelehealth" class="form-check-input" type="checkbox" />
                                    <label asp-for="EnableTelehealth" class="form-check-label">Enable Telehealth</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3 form-check">
                                    <input asp-for="EnablePrescriptionManagement" class="form-check-input" type="checkbox" />
                                    <label asp-for="EnablePrescriptionManagement" class="form-check-label">Enable Prescription Management</label>
                                </div>
                                <div class="mb-3 form-check">
                                    <input asp-for="EnableLabResults" class="form-check-input" type="checkbox" />
                                    <label asp-for="EnableLabResults" class="form-check-label">Enable Lab Results</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Save Button -->
        <div class="row mt-3">
            <div class="col-md-12">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-save"></i> Save Settings
                </button>
            </div>
        </div>
    </form>
</div>

