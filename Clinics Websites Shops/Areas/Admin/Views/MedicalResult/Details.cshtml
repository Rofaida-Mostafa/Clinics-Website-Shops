@model Clinics_Websites_Shops.Models.MedicalResult

@{
    ViewData["Title"] = "Medical Result Details";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2>@ViewData["Title"]</h2>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h4>@Model.ResultNumber - @Model.TestName</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Result Number</dt>
                        <dd class="col-sm-8">@Model.ResultNumber</dd>

                        <dt class="col-sm-4">Test Date</dt>
                        <dd class="col-sm-8">@Model.TestDate.ToString("MMMM dd, yyyy")</dd>

                        <dt class="col-sm-4">Result Date</dt>
                        <dd class="col-sm-8">@(Model.ResultDate?.ToString("MMMM dd, yyyy") ?? "N/A")</dd>

                        <dt class="col-sm-4">Patient</dt>
                        <dd class="col-sm-8">@Model.Patient?.ApplicationUser?.Name</dd>

                        <dt class="col-sm-4">Doctor</dt>
                        <dd class="col-sm-8">@(Model.Doctor?.ApplicationUser?.Name ?? "N/A")</dd>

                        <dt class="col-sm-4">Test Name</dt>
                        <dd class="col-sm-8">@Model.TestName</dd>

                        <dt class="col-sm-4">Test Category</dt>
                        <dd class="col-sm-8">@(Model.TestCategory ?? "N/A")</dd>

                        <dt class="col-sm-4">Test Code</dt>
                        <dd class="col-sm-8">@(Model.TestCode ?? "N/A")</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.Status == "Completed")
                            {
                                <span class="badge bg-success">@Model.Status</span>
                            }
                            else if (Model.Status == "Pending")
                            {
                                <span class="badge bg-warning">@Model.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Model.Status</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Flags</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsCritical)
                            {
                                <span class="badge bg-danger">Critical</span>
                            }
                            @if (Model.IsAbnormal)
                            {
                                <span class="badge bg-warning">Abnormal</span>
                            }
                            @if (!Model.IsCritical && !Model.IsAbnormal)
                            {
                                <span class="badge bg-success">Normal</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Appointment</dt>
                        <dd class="col-sm-8">@(Model.Appointment?.AppointmentNumber ?? "N/A")</dd>

                        @if (!string.IsNullOrEmpty(Model.AttachmentFileName))
                        {
                            <dt class="col-sm-4">Attachment</dt>
                            <dd class="col-sm-8">
                                <a href="@Model.AttachmentUrl" target="_blank" class="btn btn-sm btn-info">
                                    <i class="bi bi-download"></i> @Model.AttachmentFileName
                                </a>
                            </dd>
                        }
                    </dl>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ResultValue))
            {
                <div class="row mt-3">
                    <div class="col-md-12">
                        <h5>Result Value</h5>
                        <p class="border p-3 bg-light">@Model.ResultValue</p>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Findings))
            {
                <div class="row mt-3">
                    <div class="col-md-12">
                        <h5>Findings</h5>
                        <p class="border p-3 bg-light">@Model.Findings</p>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="row mt-3">
                    <div class="col-md-12">
                        <h5>Notes</h5>
                        <p class="border p-3 bg-light">@Model.Notes</p>
                    </div>
                </div>
            }

            <div class="row mt-4">
                <div class="col-md-12">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

