@model EditRoleViewModel
@using Microsoft.Extensions.Localization
@using Clinics_Websites_Shops.Areas.Admin.ViewModel
@inject IStringLocalizer<Clinics_Websites_Shops.Areas.Admin.Controllers.RoleController> localizer

@{
    ViewData["Title"] = localizer["editRole"];
}

<div class="container">
    <partial name="_BreadcrumbAdmin" />
    
    <div class="row my-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-user-shield"></i> @localizer["editRole"]
                    </h5>
                </div>
                
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="IsSystemRole" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        @if (Model.IsSystemRole)
                        {
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i> @localizer["systemRoleWarning"]
                            </div>
                        }

                        <!-- Basic Information -->
                        <div class="card mb-3">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="fas fa-info-circle"></i> @localizer["basicInformation"]</h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Name" class="form-label">@localizer["roleName"]</label>
                                        <input asp-for="Name" class="form-control" placeholder="@localizer["enterRoleName"]"
                                               readonly="@Model.IsSystemRole" />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Description" class="form-label">@localizer["description"]</label>
                                        <input asp-for="Description" class="form-control" placeholder="@localizer["enterDescription"]" />
                                        <span asp-validation-for="Description" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Permissions -->
                        <div class="card mb-3">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">
                                    <i class="fas fa-key"></i> @localizer["permissions"]
                                    <button type="button" class="btn btn-sm btn-outline-primary float-end"
                                            onclick="toggleAllPermissions(true)">
                                        @localizer["selectAll"]
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary float-end me-2"
                                            onclick="toggleAllPermissions(false)">
                                        @localizer["deselectAll"]
                                    </button>
                                </h6>
                            </div>
                            <div class="card-body">
                                @foreach (var group in Model.PermissionGroups)
                                {
                                    <div class="mb-3">
                                        <h6 class="border-bottom pb-2">
                                            <i class="fas fa-folder"></i> @group.Module
                                            <button type="button" class="btn btn-sm btn-outline-primary float-end"
                                                    onclick="toggleModulePermissions('@group.Module', true)">
                                                @localizer["selectAll"]
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary float-end me-2"
                                                    onclick="toggleModulePermissions('@group.Module', false)">
                                                @localizer["deselectAll"]
                                            </button>
                                        </h6>
                                        <div class="row">
                                            @foreach (var permission in group.Permissions)
                                            {
                                                <div class="col-md-3 mb-2">
                                                    <div class="form-check">
                                                        <input class="form-check-input permission-checkbox module-@group.Module"
                                                               type="checkbox"
                                                               name="SelectedPermissionIds"
                                                               value="@permission.Id"
                                                               id="permission_@permission.Id"
                                                               @(permission.IsAssigned ? "checked" : "") />
                                                        <label class="form-check-label" for="permission_@permission.Id">
                                                            <strong>@permission.Action</strong>
                                                            @if (!string.IsNullOrEmpty(permission.Description))
                                                            {
                                                                <br /><small class="text-muted">@permission.Description</small>
                                                            }
                                                        </label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> @localizer["back"]
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> @localizer["save"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function toggleModulePermissions(module, select) {
            const checkboxes = document.querySelectorAll('.module-' + module);
            checkboxes.forEach(cb => cb.checked = select);
        }

        function toggleAllPermissions(select) {
            const checkboxes = document.querySelectorAll('.permission-checkbox');
            checkboxes.forEach(cb => cb.checked = select);
        }
    </script>
}

