@model List<NurseListViewModel>
@using Microsoft.Extensions.Localization
@using Clinics_Websites_Shops.Areas.Admin.ViewModel
@inject IStringLocalizer<Clinics_Websites_Shops.Areas.Admin.Controllers.NurseController> localizer

@{
    ViewData["Title"] = localizer["nursesList"];
}

<div class="container">
    <partial name="_BreadcrumbAdmin" />
    
    <div class="row my-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-user-nurse"></i> @localizer["nursesList"]
                    </h5>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> @localizer["addNurse"]
                    </a>
                </div>
                
                <div class="card-body">
                    @if (Model.Count == 0)
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-user-nurse fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">@localizer["noNursesFound"]</h5>
                            <p class="text-muted">@localizer["addFirstNurse"]</p>
                            <a asp-action="Create" class="btn btn-primary">
                                <i class="fas fa-plus"></i> @localizer["addNurse"]
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>@localizer["nurseId"]</th>
                                        <th>@localizer["name"]</th>
                                        <th>@localizer["email"]</th>
                                        <th>@localizer["phoneNumber"]</th>
                                        <th>@localizer["salary"]</th>
                                        <th>@localizer["rate"]</th>
                                        <th>@localizer["description"]</th>
                                        <th>@localizer["actions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var nurse in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@nurse.NurseId</strong>
                                            </td>
                                            <td>@nurse.ApplicationUserName</td>
                                            <td>@nurse.ApplicationUserEmail</td>
                                            <td>@nurse.PhoneNumber</td>
                                            <td>
                                                <span class="badge bg-success">$@nurse.Salary.ToString("N2")</span>
                                            </td>
                                            <td>
                                                <div class="text-warning">
                                                    @for (int i = 0; i < nurse.Rate; i++)
                                                    {
                                                        <i class="fas fa-star"></i>
                                                    }
                                                    @for (int i = nurse.Rate; i < 10; i++)
                                                    {
                                                        <i class="far fa-star"></i>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <small class="text-muted">@nurse.Description</small>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-action="Details" asp-route-id="@nurse.NurseId" class="btn btn-sm btn-outline-info" title="@localizer["details"]">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a asp-action="Edit" asp-route-id="@nurse.NurseId" class="btn btn-sm btn-outline-primary" title="@localizer["edit"]">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <form asp-action="Delete" asp-route-id="@nurse.NurseId" method="post" style="display:inline;">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                                onclick="return confirm('@localizer["confirmDeleteNurse"]')" title="@localizer["delete"]">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Add some interactivity
        $(document).ready(function() {
            // Initialize DataTable if needed
            if ($('.table').length > 0 && @Model.Count > 10) {
                $('.table').DataTable({
                    "pageLength": 25,
                    "responsive": true,
                    "order": [[0, "asc"]], // Sort by nurse ID ascending
                    "columnDefs": [
                        { "orderable": false, "targets": [7] } // Disable sorting for actions column
                    ]
                });
            }
        });
    </script>
}

