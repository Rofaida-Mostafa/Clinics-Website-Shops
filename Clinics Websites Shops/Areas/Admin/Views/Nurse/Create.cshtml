@model CreateNurseViewModel
@using Microsoft.Extensions.Localization
@using Clinics_Websites_Shops.Areas.Admin.ViewModel
@inject IStringLocalizer<Clinics_Websites_Shops.Areas.Admin.Controllers.NurseController> localizer

@{
    ViewData["Title"] = localizer["create"] + " " + localizer["nurse"];
}

<div class="container">
    <partial name="_BreadcrumbAdmin" />
    <div class="row my-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-user-nurse"></i> @localizer["addNurse"]
                    </h5>
                </div>
                
                <form method="post">
                    <div class="card-body">
                        <!-- Validation Summary -->
                        <div asp-validation-summary="All" class="text-danger"></div>
                        
                        <div class="row">
                            <!-- Basic Information -->
                            <div class="col-md-6">
                                <h6 class="text-primary border-bottom pb-2">@localizer["basicInformation"]</h6>
                                
                                <div class="mb-3">
                                    <label asp-for="NurseId" class="form-label">@localizer["nurseId"] *</label>
                                    <input asp-for="NurseId" class="form-control" placeholder="NUR001" />
                                    <span asp-validation-for="NurseId" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label">@localizer["fullName"] *</label>
                                    <input asp-for="Name" class="form-control" placeholder="Jane Doe" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label">@localizer["email"] *</label>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="nurse@clinic.com" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="PhoneNumber" class="form-label">@localizer["phoneNumber"]</label>
                                    <input asp-for="PhoneNumber" type="tel" class="form-control" placeholder="+1234567890" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Password" class="form-label">@localizer["password"] *</label>
                                            <input asp-for="Password" type="password" class="form-control" />
                                            <span asp-validation-for="Password" class="text-danger"></span>
                                            <small class="text-muted">@localizer["minimumSixCharacters"]</small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="ConfirmPassword" class="form-label">@localizer["confirmPassword"] *</label>
                                            <input asp-for="ConfirmPassword" type="password" class="form-control" />
                                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Professional Information -->
                            <div class="col-md-6">
                                <h6 class="text-primary border-bottom pb-2">@localizer["professionalInformation"]</h6>
                                
                                <div class="mb-3">
                                    <label asp-for="Salary" class="form-label">@localizer["salary"] *</label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="Salary" type="number" class="form-control" step="0.01" min="0" />
                                    </div>
                                    <span asp-validation-for="Salary" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Description" class="form-label">@localizer["description"]</label>
                                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief description about the nurse"></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Rate" class="form-label">@localizer["rate"]</label>
                                    <input asp-for="Rate" type="number" class="form-control" min="1" max="10" />
                                    <span asp-validation-for="Rate" class="text-danger"></span>
                                    <small class="text-muted">@localizer["rateFrom1To10"]</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card-footer">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> @localizer["save"]
                        </button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">
                            <i class="fas fa-arrow-left"></i> @localizer["back"]
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

