@model Clinics_Websites_Shops.Models.Prescription

@{
    ViewData["Title"] = "Prescription Details";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2>@ViewData["Title"]</h2>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h4>@Model.PrescriptionNumber</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Prescription Number</dt>
                        <dd class="col-sm-8">@Model.PrescriptionNumber</dd>

                        <dt class="col-sm-4">Prescription Date</dt>
                        <dd class="col-sm-8">@Model.PrescriptionDate.ToString("MMMM dd, yyyy")</dd>

                        <dt class="col-sm-4">Patient</dt>
                        <dd class="col-sm-8">@Model.Patient?.ApplicationUser?.Name</dd>

                        <dt class="col-sm-4">Doctor</dt>
                        <dd class="col-sm-8">@(Model.Doctor?.ApplicationUser?.Name ?? "N/A")</dd>

                        <dt class="col-sm-4">Appointment</dt>
                        <dd class="col-sm-8">@(Model.Appointment?.AppointmentNumber ?? "N/A")</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Medication Name</dt>
                        <dd class="col-sm-8">@Model.MedicationName</dd>

                        <dt class="col-sm-4">Dosage</dt>
                        <dd class="col-sm-8">@(Model.Dosage ?? "N/A")</dd>

                        <dt class="col-sm-4">Frequency</dt>
                        <dd class="col-sm-8">@(Model.Frequency ?? "N/A")</dd>

                        <dt class="col-sm-4">Duration</dt>
                        <dd class="col-sm-8">@(Model.Duration ?? "N/A")</dd>

                        <dt class="col-sm-4">Quantity</dt>
                        <dd class="col-sm-8">@(Model.Quantity?.ToString() ?? "N/A")</dd>

                        <dt class="col-sm-4">Route</dt>
                        <dd class="col-sm-8">@(Model.Route ?? "N/A")</dd>
                    </dl>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Start Date</dt>
                        <dd class="col-sm-8">@(Model.StartDate?.ToString("MMMM dd, yyyy") ?? "N/A")</dd>

                        <dt class="col-sm-4">End Date</dt>
                        <dd class="col-sm-8">@(Model.EndDate?.ToString("MMMM dd, yyyy") ?? "N/A")</dd>
                    </dl>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Instructions))
            {
                <div class="row mt-3">
                    <div class="col-md-12">
                        <h5>Instructions</h5>
                        <p class="border p-3 bg-light">@Model.Instructions</p>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="row mt-3">
                    <div class="col-md-12">
                        <h5>Notes</h5>
                        <p class="border p-3 bg-light">@Model.Notes</p>
                    </div>
                </div>
            }

            <div class="row mt-4">
                <div class="col-md-12">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

